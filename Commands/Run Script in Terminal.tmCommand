<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>saveModifiedFiles</string>
	<key>command</key>
	<string>#!/bin/bash
if [[ -z "$TM_FILEPATH" ]]; then
	echo "Please save the document first."
	exit 1
fi

exec "${TM_RUBY:-ruby}" "$TM_FILEPATH"
</string>
	<key>keyEquivalent</key>
	<string>^@R</string>
	<key>name</key>
	<string>Run in Terminal</string>
	<key>runLocation</key>
	<string>terminal</string>
	<key>scope</key>
	<string>source.ruby</string>
	<key>semanticClass</key>
	<string>terminal.launcher.run.ruby</string>
	<key>uuid</key>
	<string>4444CB9A-8345-4116-8349-C359ADDA390C</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
